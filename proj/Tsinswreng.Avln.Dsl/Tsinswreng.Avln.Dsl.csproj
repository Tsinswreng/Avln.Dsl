<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>Tsinswreng.Avln.Dsl</PackageId>
		<Version>0.2.0-alpha</Version>
		<Authors>Tsinswreng</Authors>
		<Description>Fluent and DSL-style helpers for building Avalonia UI trees and compiled bindings in C#.</Description>
		<PackageTags>Avalonia;DSL;UI;Binding;Fluent</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.2" />
		<!-- <PackageReference Include="Avalonia.Themes.Fluent" /> -->
		<!-- <PackageReference Include="Avalonia.Fonts.Inter" /> -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2"/>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
